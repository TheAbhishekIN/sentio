# Copy this file to `.env.local` — Next.js does NOT read `.env.example` at runtime.
# cp .env.example .env.local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (AI reflections + weekly insights + chat)
# Production: set as encrypted secret in Cloudflare Pages dashboard
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
